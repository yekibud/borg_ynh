#!/bin/bash

source _common.sh

source /usr/share/yunohost/helpers

retrieve_backup="$install_dir/retrieve-backup"

# Listing the archives means contacting the (possibly remote) repository, which is slow.
# The getters run in subshells, so the list is cached in files to fetch it only once per run.
borg_archives_cache=$(mktemp -d)
trap 'rm -rf "$borg_archives_cache"' EXIT

_load_borg_archives() {
    local cache="$borg_archives_cache"
    if [ ! -e "$cache/list.json" ]; then
        if "$retrieve_backup" list > "$cache/list.json.tmp" 2> "$cache/stderr"; then
            : > "$cache/error"
        else
            : > "$cache/list.json.tmp"
            cp "$cache/stderr" "$cache/error"
        fi
        mv "$cache/list.json.tmp" "$cache/list.json"
    fi
    borg_archives_json=$(cat "$cache/list.json")
    borg_archives_error=$(cat "$cache/error")
}

#=================================================
# SPECIFIC GETTERS FOR TOML SHORT KEY
#=================================================

get__on_calendar() {
# YAML seems to hate systemd timer patterns like `*-*-* 03:30:00` so format custom YAML manually
    cat << EOF
    value: '$(ynh_app_setting_get --key="on_calendar")'
EOF
}

get__info() {
    cat << EOF
ask:
  en: "**Backup state:** ${old[state]}

    **Last run**: ${old[last_run]}"
  fr: "**État de la sauvegarde :** ${old[state]}

    **Dernière exécution :** ${old[last_run]}"
EOF
    if [ "${old[state]}" == "failed" ]; then
        cat << EOF
style: "danger"
EOF
    elif [ "${old[state]}" == "successful" ]; then
        cat << EOF
style: "success"
EOF
    else
        cat << EOF
style: "info"
EOF
    fi
}

get__ssh_public_key() {
    cat "/root/.ssh/id_${app}_ed25519.pub" 2>/dev/null || echo "N/A"
}

get__data_multimedia() {
    if [ -e /home/yunohost.multimedia/.nobackup ]; then
        echo "value: false"
    else
        echo "value: true"
    fi
}

get__last_backups() {
    _load_borg_archives

    local backup_list
    backup_list=$(jq -r '.archives[-50:][].name' <<< "$borg_archives_json" 2> /dev/null)

    if [ -z "$backup_list" ]; then
        echo 'ask: "*no backups yet*"'
    else
        cat << EOF
ask: |-
$(sed 's/^/  /g' <<< "$backup_list")
EOF
    fi
}

get__conf() {
    ynh_app_setting_get --key=conf
}

get__restore_status() {
    _load_borg_archives

    local style count message_en message_fr
    if [ -n "$borg_archives_error" ]; then
        style="warning"
        # Keep the end of borg's output: that's where the actual error message is
        local error
        error=$(tail -n 10 <<< "$borg_archives_error")
        message_en="Could not list the backups of the Borg repository \`$repository\` (has a first backup been made yet?):

\`\`\`
$error
\`\`\`"
        message_fr="Impossible de lister les sauvegardes du dépôt Borg \`$repository\` (une première sauvegarde a-t-elle déjà été faite ?) :

\`\`\`
$error
\`\`\`"
    else
        count=$(jq '.archives | length' <<< "$borg_archives_json" 2> /dev/null) || count=0
        if [ "$count" = "0" ]; then
            style="warning"
            message_en="No backup found in the Borg repository \`$repository\`."
            message_fr="Aucune sauvegarde trouvée dans le dépôt Borg \`$repository\`."
        else
            style="info"
            message_en="**$count** backups found in the Borg repository \`$repository\`."
            message_fr="**$count** sauvegardes trouvées dans le dépôt Borg \`$repository\`."
        fi
    fi

    cat << EOF
style: "$style"
ask:
  en: |-
$(sed 's/^/    /' <<< "$message_en")
  fr: |-
$(sed 's/^/    /' <<< "$message_fr")
EOF
}

get__restore_archive() {
    _load_borg_archives

    if [ -z "$borg_archives_json" ]; then
        echo 'value: ""'
        echo 'choices: {}'
    else
        "$retrieve_backup" choices - <<< "$borg_archives_json"
    fi
}

#=================================================
# SPECIFIC VALIDATORS FOR TOML SHORT KEYS
#=================================================
validate__on_calendar() {

    (systemd-analyze calendar "$on_calendar" > /dev/null) ||
        echo 'Please follow systemd OnCalendar format: https://man.archlinux.org/man/systemd.time.7#CALENDAR_EVENTS'
}

#=================================================
# SPECIFIC SETTERS FOR TOML SHORT KEYS
#=================================================

set__repository() {
    ynh_app_setting_set --key=repository --value="$repository"
    save_user_and_server_from_repo "$repository"
    ynh_config_add --template="env.jinja" --destination="$install_dir/.env" --jinja
}

set__data_multimedia() {
    if [ "$data_multimedia" == "0" ]; then
        mkdir -p /home/yunohost.multimedia/
        touch /home/yunohost.multimedia/.nobackup
    else
        ynh_safe_rm /home/yunohost.multimedia/.nobackup
    fi
}

set__conf() {
    if [ -n "${conf}" ]
    then
        # Update the config of the app
        ynh_app_setting_set --key=conf --value=$conf
    fi
}

set__on_calendar() {
    ynh_app_setting_set --key="on_calendar" --value="$on_calendar"
    ynh_config_add --template="systemd.timer" --destination="/etc/systemd/system/$app.timer"
    systemctl daemon-reload
}

set__remote_path() {
    ynh_app_setting_set --key=remote_path --value="$remote_path"
    ynh_config_add --template="env.jinja" --destination="$install_dir/.env" --jinja
}

#=================================================
# ACTIONS
#=================================================

run__retrieve_backup() {
    if [ -z "${restore_archive:-}" ]; then
        ynh_die "Select the backup to retrieve first."
    fi

    # The script's progress messages go through the same channel as ynh_print_info, so the admin sees them live
    if ! "$retrieve_backup" retrieve "$restore_archive" >&"${YNH_STDINFO:-1}"; then
        ynh_die "Could not retrieve '$restore_archive', see the messages above."
    fi
}

#=================================================
ynh_app_config_run $1
